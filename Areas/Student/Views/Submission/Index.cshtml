@model IEnumerable<EnglishCenterMVC.Models.Submission>
@using System.Linq
@using System

@{
    ViewData["Title"] = "My Submissions";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";

    var list = (Model ?? Enumerable.Empty<EnglishCenterMVC.Models.Submission>())
        .OrderByDescending(x => x.SubmittedAt)
        .ToList();

    bool IsGraded(EnglishCenterMVC.Models.Submission s)
        => s != null
           && (s.GradedAt != default(DateTime)
               || s.Score > 0
               || !string.IsNullOrWhiteSpace(s.Feedback));

    string StatusLabel(EnglishCenterMVC.Models.Submission s) => IsGraded(s) ? "Graded" : "Pending";
    string StatusClass(EnglishCenterMVC.Models.Submission s) => IsGraded(s) ? "ok" : "warn";

    var gradedCount = list.Count(IsGraded);
    var pendingCount = list.Count - gradedCount;
}

<head>
    <link rel="stylesheet" href="~/css/ass.css" />
</head>

<body>
    <div class="wrap">

        <!-- Hero (consistent style) -->
        <div class="hero">
            <div class="hero-inner" style="gap:16px;">
                <div style="min-width:0;">
                    <div class="hero-title" style="display:flex; align-items:center; gap:10px;">
                        <span style="display:inline-flex; width:38px; height:38px; border-radius:14px;
                                     border:1px solid var(--border); align-items:center; justify-content:center;">
                            📦
                        </span>
                        <span>My Submissions</span>
                    </div>

                    <div class="hero-sub" style="margin-top:6px;">
                        Theo dõi bài đã nộp, điểm và nhận xét — gọn gàng kiểu “workflow”.
                    </div>

                    <div class="pillrow" style="margin-top:12px;">
                        <span class="pill">Tổng: <strong>@list.Count</strong></span>
                        <span class="pill">Đã chấm: <strong>@gradedCount</strong></span>
                        <span class="pill">Chờ chấm: <strong>@pendingCount</strong></span>
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:10px;">
                    <span class="pill">Student Area</span>

                    <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">
                        <a class="btnx primary"
                           asp-area="Student"
                           asp-controller="Assignment"
                           asp-action="Index">
                            My Assignments
                        </a>
                        <a class="btnx"
                           asp-area="Student"
                           asp-controller="Courses"
                           asp-action="Index">
                            Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid">
            <!-- LEFT -->
            <div class="cardx card-pad">
                <div class="hrow">
                    <h3>Danh sách bài nộp</h3>
                    <div class="muted">Mới nhất → cũ hơn</div>
                </div>

                @if (!list.Any())
                {
                    <div class="muted" style="margin-top:10px;">Chưa có bài nộp nào.</div>
                }
                else
                {
                    <div class="alist">
                        @foreach (var s in list)
                        {
                            var hasFile = !string.IsNullOrWhiteSpace(s.FileUrl);
                            var graded = IsGraded(s);

                            var title = s.Assignment?.Title ?? $"Assignment #{s.AssignmentId}";
                            var desc = s.Assignment?.Description;
                            var shortDesc = string.IsNullOrWhiteSpace(desc)
                            ? $"Submission #{s.Id}"
                            : desc;

                            <div class="a">
                                <div class="a-left">
                                    <div class="ico">@(graded ? "✓" : "⏳")</div>

                                    <div class="a-text">
                                        <div class="a-title" title="@title">@title</div>
                                        <div class="a-desc" title="@shortDesc">@shortDesc</div>

                                        <div class="meta">
                                            <span class="tag gray">Submission #@s.Id</span>
                                            <span class="tag gray">Assignment #@s.AssignmentId</span>
                                            <span class="tag @StatusClass(s)">@StatusLabel(s)</span>

                                            @if (graded)
                                            {
                                                <span class="tag">Score: @s.Score</span>
                                                @if (!string.IsNullOrWhiteSpace(s.Feedback))
                                                {
                                                    <span class="tag ok">Has feedback</span>
                                                }
                                            }

                                            @if (!hasFile)
                                            {
                                                <span class="tag danger">Missing file</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(s.Feedback))
                                        {
                                            <div class="muted" style="margin-top:8px; line-height:1.55;">
                                                <strong style="color:rgba(0,0,0,.82);">Nhận xét:</strong>
                                                @s.Feedback
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="a-right">
                                    <a class="btnx primary"
                                       asp-area="Student"
                                       asp-controller="Submission"
                                       asp-action="Details"
                                       asp-route-subId="@s.Id">
                                        Open
                                    </a>

                                    <div class="time">
                                        Nộp: @s.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                                        @if (s.GradedAt != default(DateTime))
                                        {
                                            <br />
                                            <span>Chấm: @s.GradedAt.ToString()</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT -->
            <div class="cardx widget">
                <div class="mb-3" style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
                    <h3 style="margin:0; font-weight:900;">Quick actions</h3>
                    <span class="tag">Submissions</span>
                </div>

                <a class="btnx primary container-fluid"
                   asp-area="Student"
                   asp-controller="Assignment"
                   asp-action="Index">
                    Quay lại Assignments
                </a>

                <a class="btnx container-fluid"
                   asp-area="Student"
                   asp-controller="Courses"
                   asp-action="Index">
                    Tới Courses
                </a>

                <div class="muted" style="margin-top:10px; line-height:1.5;">
                    Tip: Pending lâu không đồng nghĩa thất bại — đôi khi chỉ là “approval pipeline”. 😄
                </div>
            </div>
        </div>
    </div>
</body>
