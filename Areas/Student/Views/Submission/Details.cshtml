                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- File block -->
            <div class="a a-stretch" style="margin-top:12px;">
                <div class="a-left">
                    <div class="ico">📄</div>
                    <div class="a-text">
                        <div class="a-title">Submitted File</div>
                        <div class="a-desc">
                            @if (hasFile)
                            {
                                <div class="cardx card-pad" id="previewCard" style="margin-top:14px; display:none;">
                                    <div class="hrow">
                                        <h3>Xem trước</h3>
                                        <div style="display:flex; gap:10px; align-items:center;">
                                            <span class="tag gray">@ext</span>
                                            <button class="btnx" type="button" id="btnClosePreview">Close</button>
                                        </div>
                                    </div>

                                    <div style="margin-top:12px;">
                                        @if (isPdf)
                                        {
                                            <iframe id="previewFrame"
                                                    src="@fileUrl"
                                                    style="width:100%; height:72vh; border:1px solid var(--border); border-radius:14px; background:#fff;">
                                            </iframe>
                                        }
                                        else if (isImg)
                                        {
                                            <img src="@fileUrl"
                                                 alt="preview"
                                                 style="width:100%; max-height:72vh; object-fit:contain; border:1px solid var(--border); border-radius:14px; background:#fff;" />
                                        }
                                        else
                                        {
                                            <div class="muted" style="line-height:1.6;">
                                                File này không hỗ trợ xem trực tiếp trong trang.
                                                Vui lòng bấm <strong>Download</strong> để mở.
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="muted">Chưa có file (hoặc file bị lỗi đường dẫn).</span>
                            }
                        </div>

                        <div class="meta">
                            <span class="tag gray">Submission #@Model.Id</span>
                            <span class="tag gray">Assignment #@Model.AssignmentId</span>
                            <span class="tag @BadgeClass()">@BadgeText()</span>
                        </div>
                    </div>
                </div>

                <div class="a-right" style="min-width: 170px;">
                    <button class="btnx primary"
                            type="button"
                            id="btnPreview"
                            @(hasFile ? "" : "disabled")
                            style="@(hasFile ? "" : "opacity:.45; cursor:not-allowed;")">
                        Preview
                    </button>

                    <a class="btnx"
                       href="@(hasFile? fileUrl : "javascript:void(0)")"
                       download
                       style="@(hasFile ? "" : "opacity:.45; pointer-events:none;")">
                        Download
                    </a>

                    <div class="time">
                        @if (hasFile)
                        {
                            <span>Ready</span>
                        }
                        else
                        {
                            <span>Unavailable</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Feedback block -->
            <div class="a" style="margin-top:12px;">
                <div class="a-left">
                    <div class="ico">💬</div>
                    <div class="a-text">
                        <div class="a-title">Feedback</div>

                        <div class="a-desc" style="max-height:none; margin-top:6px;">
                            @if (!string.IsNullOrWhiteSpace(Model.Feedback))
                            {
                                <div style="line-height:1.75;">
                                    @Model.Feedback
                                </div>
                            }
                            else
                            {
                                <span class="muted">Chưa có nhận xét.</span>
                            }
                        </div>

                        <div class="meta" style="margin-top:10px;">
                            <span class="tag @(string.IsNullOrWhiteSpace(Model.Feedback) ? "gray" : "ok")">
                                @(string.IsNullOrWhiteSpace(Model.Feedback) ? "No feedback" : "Has feedback")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="cardx widget">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
                <h3 style="margin:0; font-weight:900;">Actions</h3>
                <span class="tag">Detail</span>
            </div>

            <a class="btnx primary mb-2"
               asp-area="Student"
               asp-controller="Submission"
               asp-action="Index">
                ← My Submissions
            </a>

            <a class="btnx"
               asp-area="Student"
               asp-controller="Assignment"
               asp-action="Index">
                ← Assignments
            </a>

            <div class="muted" style="margin-top:10px; line-height:1.5;">
                Tip: nếu file mở lỗi, báo giảng viên — thường là do đường dẫn FileUrl chưa map đúng StaticFiles.
            </div>
        </div>
    </div>
    <script>
        (() => {
          const btn = document.getElementById("btnPreview");
          const card = document.getElementById("previewCard");
          const closeBtn = document.getElementById("btnClosePreview");

          if (!btn || !card) return;

          btn.addEventListener("click", () => {
            card.style.display = "block";
            card.scrollIntoView({ behavior: "smooth", block: "start" });
          });

          if (closeBtn) {
            closeBtn.addEventListener("click", () => {
              card.style.display = "none";
            });
          }
        })();
    </script>

</div>

