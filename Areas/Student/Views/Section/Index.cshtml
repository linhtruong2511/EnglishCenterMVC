@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";
    bool openFirst = true; // nicer UX: open first section by default
}
@model IEnumerable<SectionVM>

<head>
    <link rel="stylesheet" href="~/css/lessons.css" />
</head>

<body>
    <div class="sec-wrap container-fluid">

        <!-- Hero-ish header (no CSS change, just structure) -->
        <div class="sec-head" style="gap:14px;">
            <div style="min-width:0;">
                <h2 style="margin:0; display:flex; align-items:center; gap:10px;">
                    <span style="display:inline-flex; width:38px; height:38px; border-radius:14px;
                                 border:1px solid var(--border); align-items:center; justify-content:center;">
                        📚
                    </span>
                    <span>Sections</span>
                </h2>

                <div class="sub" style="margin-top:6px;">
                    Chọn 1 section để xem lessons và tiếp tục học.
                </div>

                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;">
                    <span class="pill">Tổng section: @(Model?.Count() ?? 0)</span>
                    <span class="pill">Tip: mở theo thứ tự từ trên xuống</span>
                </div>
            </div>

        @if (Model.Count() == 0)
        {
            <h2 class="text-center">Rất tiếc khóa học này chưa có bài học nào!</h2>
        }
        else
        {
            <div class="panel">
                @{
                    int idx = 0;
                }

                @foreach (var s in Model)
                {
                    idx++;

                    var lessons = s.Lessons;
                    var total = lessons.Count;

                    var completed = 0;
                    int totalMinutes = 0;
                    foreach (var l in lessons)
                    {
                        if (l.IsCompleted) completed++;
                    }

                    <details class="section" @(openFirst && idx == 1 ? "open" : "")>
                        <summary class="">
                            <div class="d-flex align-content-center justify-content-between ">
                                <div style="min-width:0;">
                                    <div class="sec-title">@s.Name</div>
                                    <div class="sec-meta">
                                        <span class="text-muted">@s.Description</span>
                                        <span>•</span>
                                        <span>@completed/@total</span>
                                    </div>
                                </div>

                                <div class="chev">˅</div>
                            </div>
                        </summary>

                        <div class="lessons">
                            @if (!lessons.Any())
                            {
                                <div class="lesson-row" style="color: var(--muted);">
                                    No lessons in this section yet.
                                </div>
                            }
                            else
                            {
                                foreach (var l in lessons.OrderBy(x => x.Order))
                                {
                                    var lessonName = l.Title ?? $"Lesson {l.Id}";
                                    var durationText = "— phút";

                                    <div class="lesson-row">
                                        <div class="l-left">
                                            <i class="bx bx-folder"></i>
                                            <div class="l-text">
                                                <div class="l-name" title="@lessonName">@lessonName</div>
                                                <div class="l-sub">@durationText</div>
                                            </div>
                                        </div>

                                        <div class="l-right">
                                            <input class="check" @(l.IsCompleted ? "checked" : "") type="checkbox" title="Mark completed" disabled/>

                                            <a class="open-btn" asp-area="Student" asp-controller="Lesson" asp-action="Index" asp-route-id="@l.Id"> Open </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </details>
                }
            </div>

        }
    </div>
</body>
