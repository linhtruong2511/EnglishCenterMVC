@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";
    bool openFirst = true; // nicer UX: open first section by default
}
@model IEnumerable<EnglishCenterMVC.Models.Section>

<head>
    <link rel="stylesheet" href="~/css/lessons.css" />
</head>

<body>
    <div class="sec-wrap container-fluid">

        <!-- Hero-ish header (no CSS change, just structure) -->
        <div class="sec-head" style="gap:14px;">
            <div style="min-width:0;">
                <h2 style="margin:0; display:flex; align-items:center; gap:10px;">
                    <span style="display:inline-flex; width:38px; height:38px; border-radius:14px;
                                 border:1px solid var(--border); align-items:center; justify-content:center;">
                        📚
                    </span>
                    <span>Sections</span>
                </h2>

                <div class="sub" style="margin-top:6px;">
                    Chọn 1 section để xem lessons và tiếp tục học.
                </div>

                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;">
                    <span class="pill">Tổng section: @(Model?.Count() ?? 0)</span>
                    <span class="pill">Tip: mở theo thứ tự từ trên xuống</span>
                </div>
            </div>

            <div class="top-actions" style="display:flex; gap:10px; align-items:center;">
                <a class="btnx"
                   asp-area="Student"
                   asp-controller="Courses"
                   asp-action="Index">← Back</a>
            </div>
        </div>

        <div class="panel">
            @{
                int idx = 0;
            }

            @if (Model == null || !Model.Any())
            {
                <div class="lesson-row" style="color: var(--muted);">
                    No sections yet.
                </div>
            }
            else
            {
                @foreach (var s in Model)
                {
                    idx++;

                    var lessons = s.Lessons ?? new List<EnglishCenterMVC.Models.Lesson>();
                    var total = lessons.Count;

                    // placeholder until you wire progress
                    var completed = 0;

                    <details class="section" @(openFirst && idx == 1 ? "open" : "")>
                        <summary class="sec-summary">
                            <div class="sec-left align-content-center justify-content-between" style="gap:12px; width:100%;">

                                <div style="min-width:0;">
                                    <div class="sec-title" title="@s.Name">@s.Name</div>

                                    <div class="sec-meta" style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                                        @if (!string.IsNullOrWhiteSpace(s.Description))
                                        {
                                            <span class="text-muted" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:52ch;">
                                                @s.Description
                                            </span>
                                            <span>•</span>
                                        }
                                        <span>@completed/@total lessons</span>
                                        <span>•</span>
                                        <span class="tag gray">Section #@s.Id</span>
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px; flex:1 1 auto; justify-content:flex-end;">
                                    <span class="tag @(total == 0 ? "gray" : "ok")">
                                        @(total == 0 ? "Empty" : "Ready")
                                    </span>
                                    <div class="chev">˅</div>
                                </div>

                            </div>
                        </summary>

                        <div class="lessons">
                            @if (!lessons.Any())
                            {
                                <div class="lesson-row" style="color: var(--muted);">
                                    No lessons in this section yet.
                                </div>
                            }
                            else
                            {
                                foreach (var l in lessons.OrderBy(x => x.Order))
                                {
                                    var lessonName = l.Title ?? $"Lesson {l.Id}";
                                    var durationText = "— phút";

                                    <div class="lesson-row">
                                        <div class="l-left">
                                            <div class="l-ico">▶</div>
                                            <div class="l-text" style="min-width:0;">
                                                <div class="l-name" title="@lessonName">@lessonName</div>
                                                <div class="l-sub">@durationText</div>
                                            </div>
                                        </div>

                                        <div class="l-right" style="display:flex; align-items:center; gap:10px;">
                                            <!-- UI-only for now -->
                                            <input class="check disabled" type="checkbox" title="Mark completed" />

                                            <a class="open-btn"
                                               asp-area="Student"
                                               asp-controller="Lesson"
                                               asp-action="Index"
                                               asp-route-id="@l.Id">
                                                Open
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </details>
                }
            }
        </div>
    </div>
</body>
