@model IEnumerable<EnglishCenterMVC.Models.Classes>
@using System.Linq
@using System

@{
    ViewData["Title"] = "My Classes";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";

    var list = (Model ?? Enumerable.Empty<EnglishCenterMVC.Models.Classes>())
        .OrderByDescending(x => x.StartDate)
        .ToList();

    var now = DateTime.Now;

    string Phase(EnglishCenterMVC.Models.Classes c)
        => (c.EndDate < now) ? "ended"
         : (c.StartDate > now) ? "upcoming"
         : "running";

    string PhaseLabel(string p) => p switch
    {
        "running" => "Running",
        "upcoming" => "Upcoming",
        _ => "Ended"
    };

    string PhaseTag(string p) => p switch
    {
        "running" => "ok",
        "upcoming" => "warn",
        _ => "gray"
    };

    var runningCount = list.Count(x => Phase(x) == "running");
    var upcomingCount = list.Count(x => Phase(x) == "upcoming");
    var endedCount = list.Count - runningCount - upcomingCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/ass.css" />
    <link rel="stylesheet" href="~/css/display.css" />
}

<div class="course-wrap container-fluid">
    <!-- HERO (with search integrated) -->
    <div class="hero" style="margin-bottom:14px;">
        <div class="hero-inner" style="display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap;">
            <div style="min-width:260px; flex:1 1 420px;">
                <div class="hero-title">My Classes</div>
                <div class="hero-sub">Lịch học + trạng thái lớp — gọn, rõ, dễ theo dõi.</div>

                <div class="pillrow" style="margin-top:10px;">
                    <span class="pill">Tổng: @list.Count</span>
                    <span class="pill">Đang diễn ra: @runningCount</span>
                    <span class="pill">Sắp bắt đầu: @upcomingCount</span>
                    <span class="pill">Đã kết thúc: @endedCount</span>
                </div>
            </div>

            <!-- RIGHT: Search inside hero -->
            <div style="flex:0 1 360px; width:100%; max-width:420px;">
                <div class="pill" style="display:inline-flex; margin-bottom:10px;">
                    Tìm theo tên lớp hoặc tên khóa học.
                </div>

                <div class="course-top" style="margin-top:0;">
                    <div class="course-actions" style="width:100%;">
                        <div class="searchbox" style="width:100%;">
                            <input id="classSearch"
                                   type="search"
                                   placeholder="Search classes..."
                                   autocomplete="off"
                                   style="width:100%;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Filters (Courses-style) -->
    <div class="course-title">
        <h2 class="fw-semibold" style="margin:0;">Danh sách lớp</h2>
    </div>
    <div class="toolbar">
        <button class="chip active" type="button" data-filter="all">All</button>
        <button class="chip" type="button" data-filter="running">Running</button>
        <button class="chip" type="button" data-filter="upcoming">Upcoming</button>
        <button class="chip" type="button" data-filter="ended">Ended</button>
    </div>

    @if (!list.Any())
    {
        <div class="empty">
            <strong>No classes assigned yet.</strong>
            <div class="muted">Khi được xếp lớp, danh sách sẽ hiện ở đây.</div>
        </div>
    }
    else
    {
        <div id="classGrid" class="grid">
            @foreach (var c in list)
            {
                var courseName = c.Course?.Name ?? $"Course #{c.Course?.Id}";
                var courseId = c.Course?.Id ?? 0;

                var phase = Phase(c);
                var tag = PhaseTag(phase);

                var daysToStart = (int)Math.Ceiling((c.StartDate - now).TotalDays);
                var daysToEnd = (int)Math.Ceiling((c.EndDate - now).TotalDays);

                <div class="cardx course-card"
                     data-name="@(c.Name ?? "")"
                     data-course="@(courseName ?? "")"
                     data-phase="@phase">

                    <!-- NO IMAGE: replace "thumb" with clean header strip -->
                    <div class="thumb" style="padding:14px; height:auto;">
                        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px;">
                            <div style="min-width:0;">
                                <div class="muted" style="font-weight:900; font-size:.85rem;">Class</div>
                                <div style="font-weight:950; font-size:1.08rem; line-height:1.25;
                                                    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                     title="@c.Name">
                                    @c.Name
                                </div>
                            </div>

                            <span class="pill @tag">@PhaseLabel(phase)</span>
                        </div>

                        <div class="muted" style="margin-top:10px; display:flex; gap:10px; flex-wrap:wrap;">
                            <span>Course: <strong style="color:rgba(0,0,0,.82)">Class #@c.Id</strong></span>
                            <span>•</span>
                            <span>Max: <strong style="color:rgba(0,0,0,.82)">@c.MaxStudent</strong></span>
                        </div>

                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
                            @if (courseId > 0)
                            {
                                <span class="pill gray">Course #@courseId</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.ClassStatus.ToString()))
                            {
                                <span class="pill">@c.ClassStatus</span>
                            }
                        </div>
                    </div>

                    <div class="body">
                        <!-- Timeline block -->
                        <div class="desc" style="display:grid; gap:6px;">
                            <div class="muted">
                                Start: <strong>@c.StartDate.ToString("dd/MM/yyyy")</strong>
                                &nbsp;•&nbsp;
                                End: <strong>@c.EndDate.ToString("dd/MM/yyyy")</strong>
                            </div>

                            @if (phase == "running")
                            {
                                <div class="muted">
                                    Status: <span class="pill ok" style="display:inline-block;">In session</span>
                                    <span class="muted" style="margin-left:8px;">(ends in @Math.Max(daysToEnd, 0)d)</span>
                                </div>
                            }
                            else if (phase == "upcoming")
                            {
                                <div class="muted">
                                    Status: <span class="pill warn" style="display:inline-block;">Starts in @Math.Max(daysToStart, 0)d</span>
                                </div>
                            }
                            else
                            {
                                <div class="muted">
                                    Status: <span class="pill gray" style="display:inline-block;">Completed</span>
                                </div>
                            }
                        </div>

                        <!-- Meta row (kept light) -->
                        <div class="meta" style="margin-top:10px;">
                            <span class="pill @tag">@PhaseLabel(phase)</span>
                            <span class="pill gray">@c.StartDate.ToString("dd/MM") → @c.EndDate.ToString("dd/MM")</span>
                        </div>
                    </div>

                    <div class="btnrow">
                        <a class="btnx primary"
                           asp-action="Details"
                           asp-route-id="@c.Id">Open</a>

                        <a class="btnx"
                           asp-action="Details"
                           asp-route-id="@c.Id">Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    (function () {
        const search = document.getElementById("classSearch");
        const grid = document.getElementById("classGrid");
        const chips = document.querySelectorAll(".chip");

        if (!grid) return;

        let activeFilter = "all";

        function applyFilter() {
            const q = (search?.value || "").trim().toLowerCase();
            const cards = grid.querySelectorAll(".course-card");

            cards.forEach(card => {
                const name = (card.getAttribute("data-name") || "").toLowerCase();
                const course = (card.getAttribute("data-course") || "").toLowerCase();
                const phase = (card.getAttribute("data-phase") || "").toLowerCase();

                const matchText = !q || name.includes(q) || course.includes(q);
                const matchPhase = activeFilter === "all" || phase === activeFilter;

                card.style.display = (matchText && matchPhase) ? "" : "none";
            });
        }

        if (search) search.addEventListener("input", applyFilter);

        chips.forEach(btn => {
            btn.addEventListener("click", () => {
                chips.forEach(x => x.classList.remove("active"));
                btn.classList.add("active");
                activeFilter = btn.getAttribute("data-filter") || "all";
                applyFilter();
            });
        });

        applyFilter();
    })();
</script>
