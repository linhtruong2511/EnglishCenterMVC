@model IEnumerable<EnglishCenterMVC.Models.Course>
@using System.Linq
@using System.Collections.Generic

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Student/Views/Shared/_Layout.cshtml";

    // Categories from DB (controller puts ALL categories here)
    var cats = (ViewBag.Categories as IEnumerable<EnglishCenterMVC.Models.Category>)
               ?.OrderBy(c => c.Id)
               .ToList()
               ?? new List<EnglishCenterMVC.Models.Category>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/ass.css" />
    <link rel="stylesheet" href="~/css/display.css" />
}

<div class="course-wrap container-fluid">
    <div class="cardx course-hero">
        <div class="course-hero-inner">

            <!-- Decorative hero art -->
            <div class="course-hero-art" aria-hidden="true">
                <svg viewBox="0 0 260 140" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="g1" x1="0" x2="1" y1="0" y2="1">
                            <stop offset="0" stop-color="#3b82f6" stop-opacity=".55" />
                            <stop offset="1" stop-color="#10b981" stop-opacity=".35" />
                        </linearGradient>
                    </defs>
                    <rect x="12" y="18" rx="18" ry="18" width="160" height="104" fill="url(#g1)" />
                    <rect x="28" y="34" rx="10" ry="10" width="128" height="16" fill="#ffffff" opacity=".80" />
                    <rect x="28" y="58" rx="10" ry="10" width="92" height="14" fill="#ffffff" opacity=".65" />
                    <rect x="28" y="80" rx="10" ry="10" width="116" height="14" fill="#ffffff" opacity=".55" />
                    <circle cx="214" cy="48" r="22" fill="#3b82f6" opacity=".25" />
                    <circle cx="224" cy="86" r="28" fill="#10b981" opacity=".20" />
                </svg>
            </div>

            <div class="course-hero-left">
                <h2 class="course-hero-title">My Courses</h2>
                <div class="muted course-hero-sub">
                    Pick up where you left off. Keep the momentum — boring consistency wins.
                </div>

                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;">
                    <span class="tag">Student Area</span>
                    <span class="tag gray">Courses</span>
                </div>
            </div>

            <div class="course-hero-right">
                <div class="course-search">
                    <input id="courseSearch" type="search" placeholder="Search courses..." autocomplete="off" />
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar: render categories from DB -->
    <div class="toolbar">
        <button class="chip active" type="button" data-filter="all">All</button>

        @foreach (var c in cats)
        {
            <button class="chip" type="button" data-filter="cat-@c.Id">@c.Name</button>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <strong>No courses assigned yet.</strong>
            <div class="muted">Once you enroll, your courses will show up here.</div>
        </div>
    }
    else
    {
        <div id="courseGrid" class="grid">
            @foreach (var item in Model)
            {
                // IMPORTANT: filter should use FK CategoryId if available
                var catId = item.CategoryId;              // <-- change from item.Category?.Id
                var categoryKey = $"cat-{catId}";

                // Name can still be shown (either from navigation or map via cats)
                var categoryName =
                item.Category?.Name
                ?? cats.FirstOrDefault(x => x.Id == catId)?.Name
                ?? "Unknown";

                var price = item.Price;
                var salePct = item.Sale; // assume % (0-100)
                var hasSale = salePct != null && salePct > 0;
                var finalPrice = hasSale ? price * (decimal)(100 - (decimal)salePct) / 100m : price;

                <div class="cardx course-card"
                     data-name="@(item.Name ?? "")"
                     data-category="@categoryKey"
                     data-desc="@(item.Description ?? "")">

                    <div class="thumb">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        else
                        {
                            <span class="muted">No image</span>
                        }
                    </div>

                    <div class="body">
                        <div class="name">@item.Name</div>
                        <div class="desc">@item.Description</div>

                        <div class="meta">
                            <span class="pill">@categoryName</span>

                            @if (hasSale)
                            {
                                <span class="pill">On Sale</span>
                            }
                        </div>

                        <div class="price-row">
                            <div class="price">
                                @finalPrice.ToString("N0")
                                @if (hasSale)
                                {
                                    <span class="old">@price.ToString("N0")</span>
                                }
                            </div>
                            @if (hasSale)
                            {
                                <span class="sale">-@salePct%</span>
                            }
                        </div>
                    </div>

                    <div class="btnrow">
                        <a class="btnx primary"
                           asp-controller="Section"
                           asp-action="Index"
                           asp-route-courseId="@item.Id">Open</a>
                        <a class="btnx"
                           asp-action="Details"
                           asp-route-id="@item.Id">Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    (function () {
        const search = document.getElementById("courseSearch");
        const grid = document.getElementById("courseGrid");
        const chips = document.querySelectorAll(".chip");

        if (!grid) return;

        let activeFilter = "all";

        function applyFilter() {
            const q = (search?.value || "").trim().toLowerCase();
            const cards = grid.querySelectorAll(".course-card");

            cards.forEach(card => {
                const name = (card.getAttribute("data-name") || "").toLowerCase();
                const desc = (card.getAttribute("data-desc") || "").toLowerCase();
                const cat  = (card.getAttribute("data-category") || "").toLowerCase();

                const matchText = !q || name.includes(q) || desc.includes(q);
                const matchCat  = activeFilter === "all" || cat === activeFilter;

                card.style.display = (matchText && matchCat) ? "" : "none";
            });
        }

        if (search) search.addEventListener("input", applyFilter);

        chips.forEach(btn => {
            btn.addEventListener("click", () => {
                chips.forEach(x => x.classList.remove("active"));
                btn.classList.add("active");
                activeFilter = btn.getAttribute("data-filter") || "all";
                applyFilter();
            });
        });

        applyFilter();
    })();
</script>
